{
  "name": "claude-status",
  "displayName": "Claude Status",
  "description": "WorkTreeDev: a fleet roster for parallel Claude/Codex worktrees driven by the wtd.exe daemon — session list with groups and search, New Session picker, usage limits, native commit/diff browser, and status-coloured worktree folders.",
  "version": "0.0.91",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeStatus.smartPaste",
        "title": "Claude Status: Paste image or text into session"
      },
      {
        "command": "claudeStatus.newSession",
        "title": "New Session",
        "category": "WorkTreeDev",
        "icon": "$(add)"
      },
      {
        "command": "claudeStatus.startDaemon",
        "title": "Start Daemon",
        "category": "WorkTreeDev",
        "icon": "$(play)"
      },
      {
        "command": "claudeStatus.stopDaemon",
        "title": "Stop Daemon",
        "category": "WorkTreeDev",
        "icon": "$(debug-stop)"
      },
      {
        "command": "claudeStatus.toggleDaemon",
        "title": "Toggle Daemon (Start/Stop)",
        "category": "WorkTreeDev"
      },
      {
        "command": "claudeStatus.openAssistant",
        "title": "Open Assistant",
        "category": "WorkTreeDev",
        "icon": "$(hubot)"
      },
      {
        "command": "claudeStatus.openTerminal",
        "title": "Open Dev Terminal",
        "category": "WorkTreeDev",
        "icon": "$(terminal)"
      },
      {
        "command": "claudeStatus.openSettings",
        "title": "Open Settings",
        "category": "WorkTreeDev",
        "icon": "$(settings-gear)"
      },
      {
        "command": "claudeStatus.changes.refresh",
        "title": "Refresh Changes",
        "category": "WorkTreeDev",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeStatus.changes.pick",
        "title": "Show Changes for Worktree…",
        "category": "WorkTreeDev",
        "icon": "$(list-selection)"
      },
      {
        "command": "claudeStatus.changes.hideTests",
        "title": "Hide Test Files",
        "category": "WorkTreeDev",
        "icon": "$(beaker)"
      },
      {
        "command": "claudeStatus.changes.showTests",
        "title": "Show Test Files",
        "category": "WorkTreeDev",
        "icon": "$(beaker-stop)"
      },
      {
        "command": "claudeStatus.changes.openDiff",
        "title": "Open Changes",
        "category": "WorkTreeDev",
        "icon": "$(compare-changes)"
      },
      {
        "command": "claudeStatus.changes.openFile",
        "title": "Open File",
        "category": "WorkTreeDev",
        "icon": "$(go-to-file)"
      },
      {
        "command": "claudeStatus.changes.openAll",
        "title": "Open All Changes",
        "category": "WorkTreeDev",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "claudeStatus.changes.copySha",
        "title": "Copy Commit SHA",
        "category": "WorkTreeDev"
      },
      {
        "command": "claudeStatus.showChanges",
        "title": "Show Changes Panel",
        "category": "WorkTreeDev",
        "icon": "$(git-compare)"
      }
    ],
    "keybindings": [
      {
        "command": "claudeStatus.smartPaste",
        "key": "ctrl+v",
        "when": "terminalFocus && isWindows"
      }
    ],
    "colors": [
      {
        "id": "claudeStatus.working",
        "description": "Claude working",
        "defaults": {
          "dark": "#4aa3ff",
          "light": "#0b66c3",
          "highContrast": "#4aa3ff"
        }
      },
      {
        "id": "claudeStatus.input",
        "description": "Your turn",
        "defaults": {
          "dark": "#ffd83d",
          "light": "#b58900",
          "highContrast": "#ffd83d"
        }
      },
      {
        "id": "claudeStatus.reviewing",
        "description": "Waiting on review",
        "defaults": {
          "dark": "#c586f0",
          "light": "#8250df",
          "highContrast": "#d2a8ff"
        }
      },
      {
        "id": "claudeStatus.pr",
        "description": "PR ready",
        "defaults": {
          "dark": "#5cc8ff",
          "light": "#0a86d6",
          "highContrast": "#5cc8ff"
        }
      },
      {
        "id": "claudeStatus.done",
        "description": "Done",
        "defaults": {
          "dark": "#3fd35f",
          "light": "#1a7f37",
          "highContrast": "#3fd35f"
        }
      },
      {
        "id": "claudeStatus.stopped",
        "description": "Stopped (no session)",
        "defaults": {
          "dark": "#ff5c57",
          "light": "#cf222e",
          "highContrast": "#ff5c57"
        }
      }
    ],
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "claudeStatus.limit",
          "name": "Dev workflow summary",
          "contextualTitle": "Dev workflow summary",
          "order": 1,
          "visibility": "visible"
        },
        {
          "id": "claudeStatus.changes",
          "name": "Worktree Changes",
          "contextualTitle": "Worktree Changes",
          "icon": "$(git-compare)",
          "order": 2,
          "visibility": "collapsed"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "claudeStatus.changes.pick",
          "when": "view == claudeStatus.changes",
          "group": "navigation@1"
        },
        {
          "command": "claudeStatus.changes.hideTests",
          "when": "view == claudeStatus.changes && !claudeStatus.testsHidden",
          "group": "navigation@2"
        },
        {
          "command": "claudeStatus.changes.showTests",
          "when": "view == claudeStatus.changes && claudeStatus.testsHidden",
          "group": "navigation@2"
        },
        {
          "command": "claudeStatus.changes.refresh",
          "when": "view == claudeStatus.changes",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeStatus.changes.openAll",
          "when": "view == claudeStatus.changes && viewItem =~ /^(commit|changes)$/",
          "group": "inline"
        },
        {
          "command": "claudeStatus.changes.openAll",
          "when": "view == claudeStatus.changes && viewItem =~ /^(commit|changes)$/",
          "group": "1_open"
        },
        {
          "command": "claudeStatus.changes.copySha",
          "when": "view == claudeStatus.changes && viewItem == commit",
          "group": "2_copy"
        },
        {
          "command": "claudeStatus.changes.openFile",
          "when": "view == claudeStatus.changes && viewItem =~ /File$/",
          "group": "inline"
        },
        {
          "command": "claudeStatus.changes.openDiff",
          "when": "view == claudeStatus.changes && viewItem =~ /File$/",
          "group": "1_open@1"
        },
        {
          "command": "claudeStatus.changes.openFile",
          "when": "view == claudeStatus.changes && viewItem =~ /File$/",
          "group": "1_open@2"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeStatus.changes.openDiff",
          "when": "false"
        },
        {
          "command": "claudeStatus.changes.openFile",
          "when": "false"
        },
        {
          "command": "claudeStatus.changes.openAll",
          "when": "false"
        },
        {
          "command": "claudeStatus.changes.copySha",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "WorkTreeDev",
      "properties": {
        "claudeStatus.changesPanel": {
          "type": "boolean",
          "default": true,
          "description": "Dock a Changes panel (branch commits + live diff of the focused session) in the right half of the editor area, with the session on the left."
        },
        "claudeStatus.sessionShell": {
          "type": "boolean",
          "default": true,
          "description": "Give each session a plain shell terminal in its worktree, in the bottom 20% of the left column under the Claude chat."
        }
      }
    }
  }
}
