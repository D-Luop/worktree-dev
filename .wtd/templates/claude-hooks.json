{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__DEV__/.wtd/hooks/wt-status.sh stop"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "__DEV__/.wtd/hooks/wt-status.sh limited"
          }
        ]
      },
      {
        "matcher": "overloaded|authentication_failed|oauth_org_not_allowed|account_on_hold|verification_required|billing_error|invalid_request|model_not_found|server_error|unknown|max_output_tokens|cloud_credential_error",
        "hooks": [
          {
            "type": "command",
            "command": "__DEV__/.wtd/hooks/wt-status.sh stop"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__DEV__/.wtd/hooks/wt-status.sh stop"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__DEV__/.wtd/hooks/wt-status.sh working"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__DEV__/.wtd/hooks/wt-status.sh sessionend"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__DEV__/.wtd/hooks/wt-status.sh tool"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "__DEV__/.wtd/hooks/wt-status.sh edit"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "__DEV__/.wtd/hooks/plan-nudge.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "__DEV__/.wtd/hooks/plan-hint.sh"
          }
        ]
      }
    ]
  }
}
